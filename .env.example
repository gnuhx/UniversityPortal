# Copy this file to .env and fill in your values.
# docker compose up reads .env automatically — never commit .env.

# SQL Server connection string
CONNECTION_STRING=Server=<host>;Database=<db_name>;User Id=<user>;Password=<password>;Encrypt=True;TrustServerCertificate=True;

JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
